# 仅供本机服务端读取。不要使用 VITE_ 前缀，也不要提交真实密钥。
DASHSCOPE_API_KEY=your-bailian-api-key
DASHSCOPE_WORKSPACE_ID=your-workspace-id
DASHSCOPE_IMAGE_MODEL=wan2.7-image
DASHSCOPE_QWEN_MODEL=qwen-plus
# 以下地址通常无需修改。
DASHSCOPE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# PostgreSQL 仅供 Node.js API 使用。线上应分别使用最小 DML 权限和 migration 权限账户。
DATABASE_URL=postgresql://storyverse_app:replace-me@127.0.0.1:5432/storyverse
DATABASE_MIGRATOR_URL=postgresql://storyverse_migrator:replace-me@127.0.0.1:5432/storyverse
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
SESSION_SECRET=replace-with-at-least-32-random-bytes
FRONTEND_ORIGINS=http://127.0.0.1:4173
PORT=3000

# 部署独立图片接口后，可让前端改用该地址。
# EdgeOne Pages 生产环境使用同源路径。
VITE_BASE_PATH=/
VITE_API_BASE_URL=/api/v1
VITE_IMAGE_API_URL=/api/generate-image

# 仅配置在边缘 Pages Functions 中，不进入浏览器包。可指向 SAE 的固定 HTTPS 地址。
BACKEND_API_ORIGIN=https://replace-me.sae.aliyuncs.com
